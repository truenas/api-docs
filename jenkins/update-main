/*
Our default Jenkins pipeline we use to update api docs site
*/

pipeline {
  agent { label 'hugo-pr' }

  environment {
        HUGO_ENV = "production"
        PATH = "/usr/local/go/bin:${env.PATH}"
  }

  stages {
    stage('Build') {
        steps {
            // Restore archived versions to storj from the git snapshots. `copy` only adds
            // missing files (never deletes), so this is a no-op when storj is intact and
            // self-heals it otherwise. Must run before pull_api_docs.sh, which lists storj
            // to detect versions that dropped out of the build.
            sh 'rclone copy archive-backups api-storj:api.truenas.com --stats-one-line --stats 5s'
            sh 'hugo mod clean'
            // Fetch only docs-shared (main), no -u: keeps the shared module fresh without
            // force-upgrading any other module. The geekdoc theme is local, so the only module
            // today is docs-shared — but this is forward-safe for the eventual Docsy migration,
            // when Docsy becomes a pinned module that must NOT be force-upgraded in CI.
            sh 'hugo mod get github.com/truenas/docs-shared@main'
            sh 'npm install -D --save autoprefixer'
            sh 'npm install -D --save postcss-cli'
			sh 'pip3 install -r requirements.txt --break-system-packages'
			sh 'bash ./scripts/pull-truenas-release-data.sh'
			sh 'bash ./scripts/pull_api_docs.sh'
			sh 'bash ./scripts/remove_current_labeling.sh'
            sh 'hugo -d public --gc --minify --cleanDestinationDir'
			sh 'npx pagefind --site public'
			sh 'bash ./scripts/cleanup_api_docs.sh'
        }
    }
    stage('Publish') {
        steps {
            sh 'rclone --stats-one-line --stats 5s --exclude-from archived-rclone-exclude.txt sync public/ api-storj:api.truenas.com'
        }
    }
  }
}
